# Ami Home Care — web server settings (Apache, as used by one.com hosting)
# Upload this file to the main website folder when the new site goes live.
# If the site shows "Internal Server Error" after uploading it, rename this file to
# "htaccess-disabled.txt" and contact one.com support.

# Custom "page not found" page
ErrorDocument 404 /404.html

# Send visitors and search engines from the old Website Builder addresses to the new pages
<IfModule mod_alias.c>
  Redirect 301 /our-services /services.html
  Redirect 301 /about-us /about.html
  Redirect 301 /vacancies /careers.html
  Redirect 301 /privacy-notice-for-service-users.html /privacy.html
  Redirect 301 /privacy-notice-for-service-users /privacy.html
  Redirect 301 /net-zero-policy.html /policies.html
  Redirect 301 /net-zero-policy /policies.html
  Redirect 301 /carbon-reduction-plan.html /policies.html
  Redirect 301 /carbon-reduction-plan /policies.html
  Redirect 301 "/Privacy Notice for Service Users.pdf" /docs/privacy-notice-for-service-users.pdf
  Redirect 301 "/Net Zero Commitment Policy.pdf" /docs/net-zero-commitment-policy.pdf
  Redirect 301 "/Carbon Reduction Plan.pdf" /docs/carbon-reduction-plan.pdf
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Security and caching headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(webp|png|jpe?g|ico|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Make sure manifest and module files are served with the right type
AddType application/manifest+json .webmanifest
AddType text/javascript .mjs
